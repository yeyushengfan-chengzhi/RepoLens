GITHUB_TOKEN=
# Docker Compose reaches the host gateway through this name. The Windows
# launcher overrides it with http://127.0.0.1:8642/v1 for local processes.
HERMES_API_BASE=http://host.docker.internal:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
REPOLENS_DB_PATH=data/repolens.db

# Cost estimates only. Update these values when the configured DeepSeek model
# or official pricing changes.
DEEPSEEK_PRICING_MODEL=deepseek-v4-flash
DEEPSEEK_CACHE_HIT_CNY_PER_M=0.02
DEEPSEEK_CACHE_MISS_CNY_PER_M=1
DEEPSEEK_OUTPUT_CNY_PER_M=2
